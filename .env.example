# Backend only: export these variables in your shell. This starter does not auto-load .env files.
# Never commit real secrets.
OPENAI_API_KEY=
AGENTOS_MODEL=
# Optional compatible endpoint: default https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
# Local development SQLite path
AGENTOS_DB_PATH=./.agentos/state.sqlite3
# Frontend: copy this line into apps/web/.env.local
NEXT_PUBLIC_AGENTOS_API_URL=http://127.0.0.1:8000
